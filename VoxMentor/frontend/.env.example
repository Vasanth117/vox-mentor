# Copy this file to .env.local for local overrides (optional)
# Vite bakes these values at build time — never commit .env.local

# Override the backend API base URL (default: http://localhost:8000/api)
# For production, set this in the Vercel dashboard instead of a file
VITE_API_BASE_URL=http://localhost:8000/api

# Override the backend port used for the auto-constructed fallback URL
VITE_BACKEND_PORT=8000
